{
  "name": "stave",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first delivery board for teams of coding agents.",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm --filter @stave/desktop start",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "verify": "biome ci --error-on-warnings . && pnpm typecheck && pnpm test && knip",
    "check": "pnpm verify",
    "prepare": "lefthook install",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.mts",
    "e2e": "pnpm --filter @stave/desktop package && pnpm --filter @stave/desktop e2e",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "5.0.2",
    "knip": "6.40.0",
    "lefthook": "2.1.17",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
