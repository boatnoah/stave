{
  "name": "stave",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first delivery board for teams of coding agents.",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm --filter @stave/desktop start",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "verify": "biome ci --error-on-warnings . && pnpm typecheck && pnpm test",
    "check": "pnpm verify",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.17"
  },
  "engines": {
    "node": ">=24"
  }
}
