{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.vite",
      "!**/out",
      "!pnpm-lock.yaml",
      "!.pnpm-store",
      "!assets/avatars/exports"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          },
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "**/tests/fixtures/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/renderer/**",
        "apps/desktop/src/shared/**",
        "packages/domain/src/**",
        "packages/avatar/src/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@stave/db": "Only the desktop main process may use the database.",
                  "@stave/git-workspace": "Only the desktop main process may manage Git workspaces.",
                  "@stave/agent-runtime": "Only the desktop main process may run agents.",
                  "electron": "Only the main process and preload may import Electron."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@stave/desktop": "Packages must not depend on the desktop app."
                },
                "patterns": [
                  {
                    "group": ["**/apps/**"],
                    "message": "Packages must not depend on the desktop app."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
